# Docker: nel repo restano solo i file di configurazione (compose, README,
# php/, script). Database, core WordPress, plugin, temi e upload sono
# generati in locale dal container.
docker/wordpress-docker/*
!docker/wordpress-docker/docker-compose.yml
!docker/wordpress-docker/README.md
!docker/wordpress-docker/php/
docker/wordpress-docker/.env
.opencode/
.omo/
test_altri_programmi/
.zsh_history
.zcompdump*

# Artefatti locali Playwright MCP e screenshot di lavoro
.playwright-mcp/
quick-load-app-current.png

# Web usata solo per la verifica locale
/web/

# Contatore build solo-debug incrementato da script/run_debug.sh
.debug_build_nr


workspace-vscode.code-workspace

# Codice di localizzazione generato da `flutter gen-l10n`.
# Si rigenera con `flutter gen-l10n` (o `flutter pub get`), non va versionato.
lib/l10n/generated/

# Elenco delle chiavi non tradotte, generato dalla stessa configurazione.
lib/l10n/untranslated.json

# Configurazione shell locale e copie di backup
.zshrc
*.bak
*.backup

# Override locale delle dipendenze (report_flutter da ../../report)
pubspec_overrides.yaml
# Widget Preview related
.widget_preview/
